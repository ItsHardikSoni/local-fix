# Copy this file to `.env` and fill in values from the Supabase dashboard
# (Project Settings → API). Never commit `.env`.
#
# Use the project URL only, without `/rest/v1/`.
# Use the anon / publishable key. Never put the service_role key in this app.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
