{
  "expo": {
    "name": "LocalFix",
    "slug": "localfix",
    "version": "0.1.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/5c1e47e7-6810-485c-84dd-add2e64fcddf"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "localfix",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/icon.png",
      "bundleIdentifier": "com.ayushlabs.localfix"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.ayushlabs.localfix",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/icon.png",
        "backgroundImage": "./assets/icon.png",
        "monochromeImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "X-Frame-Options": "DENY",
            "X-Content-Type-Options": "nosniff",
            "Referrer-Policy": "strict-origin-when-cross-origin",
            "Permissions-Policy": "camera=(), microphone=(), geolocation=(self)",
            "Cross-Origin-Opener-Policy": "same-origin",
            "X-XSS-Protection": "1; mode=block"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow LocalFix to include your location with service requests."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C1B33",
          "image": "./assets/icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "headers": {
          "X-Frame-Options": "DENY",
          "X-Content-Type-Options": "nosniff",
          "Referrer-Policy": "strict-origin-when-cross-origin",
          "Permissions-Policy": "camera=(), microphone=(), geolocation=(self)",
          "Cross-Origin-Opener-Policy": "same-origin",
          "X-XSS-Protection": "1; mode=block"
        }
      },
      "eas": {
        "projectId": "5c1e47e7-6810-485c-84dd-add2e64fcddf"
      }
    }
  }
}
